<!-- Page header -->
<div class="page-header d-print-none">
    <div class="container-xl">
      <div class="row g-2 align-items-center">
        <div class="col">
          <!-- Page pre-title -->
          <div class="page-pretitle">Overview</div>
          <h2 class="page-title">Formulir Lamaran</h2>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Page body -->
  <div class="page-body">
    <div class="container-xl">
      <div class="row row-deck row-cards">
        <div class="col-md-6 mt-3">
          <form class="card" action="/jobs/apply/now/<%= job.id %>" method="post">
            <div class="card-header">
              <h3 class="card-title">Form</h3>
            </div>
            <div class="card-body">
              <div class="mb-3">
                <label class="form-label">Job Title</label>
                <input type="text" class="form-control" disabled value="<%= job.title %>" />
              </div>
              <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input type="text" class="form-control" name="userId" hidden value="<%= user.id %>" />
                <input type="text" class="form-control" disabled value="<%= user.name %>" />
              </div>
              <div class="mb-3">
                <label class="form-label">Major</label>
                <input type="text" class="form-control" name="major" placeholder="e.g. Computer Science" />
              </div>
              <div class="mb-3">
                <label class="form-label">Gender</label>
                <select class="form-control" name="gender">
                  <option value="" disabled selected>Select your gender</option>
                  <option value="male">Male</option>
                  <option value="female">Female</option>
                </select>
              </div>
              <div class="row">
                <div class="col-lg-6">
                  <div class="mb-3">
                    <label class="form-label">Email</label>
                    <div class="input-group input-group-flat">
                      <input type="text" class="form-control" name="email" disabled value="<%= user.email %>" />
                    </div>
                  </div>
                </div>
                <div class="col-lg-6">
                  <div class="mb-3">
                    <label class="form-label">No. WhatsApp</label>
                    <input type="number" name="noWhatsapp" class="form-control" />
                  </div>
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label">Curriculum Vitae</label>
                <input type="text" class="form-control" name="curriculumVitae" placeholder="e.g. link drive your curriculum vitae (pdf, docx)" />
              </div>
              <div class="mb-3">
                <label class="form-label">Portofolio</label>
                <input type="text" class="form-control" name="portofolio" placeholder="e.g. link drive your portofolio (pdf, docx)" />
              </div>
              <div class="col-lg-12 mb-3">
                <div>
                  <label class="form-label">Address</label>
                  <textarea class="form-control" name="address" rows="8"></textarea>
                </div>
              </div>
              <div class="col-lg-12 mb-3">
                <div>
                  <label class="form-label">Work Experience</label>
                  <textarea class="form-control" name="workExperience" rows="8"></textarea>
                </div>
              </div>
            </div>
            <div class="card-footer text-center" style="display: flex; justify-content: space-between">
              <a href="/jobs/apply/detail/<%= job.id %>" class="btn btn-link link-secondary"> Kembali </a>
              <button type="submit" class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M12 5l0 14" />
                  <path d="M5 12l14 0" />
                </svg>
                Kirim Lamaran
              </button>
            </div>
        </div>
        </form>
      </div>
    </div>
  </div>