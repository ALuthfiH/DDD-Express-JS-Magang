<!-- Page header -->
<div class="page-header d-print-none">
    <div class="container-xl">
      <div class="row g-2 align-items-center">
        <div class="col">
          <!-- Page pre-title -->
          <div class="page-pretitle">Overview</div>
          <h2 class="page-title">Tambahkan Lowongan Pekerjaan</h2>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Page body -->
  <div class="page-body">
    <div class="container-xl">
      <div class="row row-deck row-cards">
        <div class="col-md-6 mt-3">
          <form class="card" action="/jobs/create" method="post">
            <div class="card-header">
              <h3 class="card-title">Form</h3>
            </div>
            <div class="card-body">
              <div class="mb-3">
                <label class="form-label">Title</label>
                <input type="text" class="form-control" name="title" placeholder="Your report name" />
              </div>
              <div class="row">
                <div class="col-lg-6">
                  <div class="mb-3">
                    <label class="form-label">Location</label>
                    <div class="input-group input-group-flat">
                      <input type="text" class="form-control" name="location" value="Surabaya, Indonesia" autocomplete="off" />
                    </div>
                  </div>
                </div>
                <div class="col-lg-6">
                  <div class="mb-3">
                    <label class="form-label">Image</label>
                    <input type="text" name="image" class="form-control" />
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-lg-6">
                  <div class="mb-3">
                    <label class="form-label">Start Date</label>
                    <input type="date" name="startDate" class="form-control" />
                  </div>
                </div>
                <div class="col-lg-6">
                  <div class="mb-3">
                    <label class="form-label">End Date</label>
                    <input type="date" name="endDate" class="form-control" />
                  </div>
                </div>
                <div class="col-lg-12">
                  <div class="mb-3">
                    <label class="form-label">Description</label>
                      <textarea name="description" id="tinymce-mytextarea"></textarea>
                  </div>
                </div>
              </div>
            </div>
            <div class="card-footer text-center" style="display: flex; justify-content: space-between">
              <a href="/jobs" class="btn btn-link link-secondary"> Kembali </a>
              <button type="submit" class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M12 5l0 14" />
                  <path d="M5 12l14 0" />
                </svg>
                Tambahkan Lowongan
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>